# SKILLSETRA Demo — works without Supabase authentication.
DEMO_MODE=true
ENVIRONMENT=demo

# Optional Supabase catalog / future production connection.
# Leave blank for the self-contained demo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
AI_PROVIDER=puter
PUTER_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional GitHub integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=20
