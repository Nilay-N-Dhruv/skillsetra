# SKILLSETRA — FINAL DEMO DEPLOYMENT
# The demo works with no external API keys.
DEMO_MODE=true
ENVIRONMENT=demo
AI_PROVIDER=puter
PUTER_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional services — fill only the ones you actually use.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Internal full-stack routing; do not change for the bundled Docker demo.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
